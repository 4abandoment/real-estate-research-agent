{
  "display_information": {
    "name": "Real Estate Research Agent",
    "description": "Research helper for real-estate finance teams",
    "background_color": "#1f2d3d"
  },
  "features": {
    "bot_user": {
      "display_name": "Research Agent",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/sql",
        "description": "Show the last SQL query the agent ran",
        "usage_hint": "[optional]",
        "should_escape": false
      },
      {
        "command": "/status",
        "description": "Agent status: data loaded, recent queries, cost",
        "usage_hint": "",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "commands",
        "channels:history",
        "groups:history",
        "users:read",
        "reactions:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_mention", "message.channels", "message.groups"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": true,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false,
    "is_mcp_enabled": true
  }
}
