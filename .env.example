# Slack (Socket Mode)
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
SLACK_ADMIN_CHANNEL_ID=

# Slack app configuration token (for apps.manifest.*; expires after 12h)
SLACK_CONFIG_TOKEN=xoxe.xoxp-
SLACK_CONFIG_REFRESH_TOKEN=xoxe-
SLACK_APP_ID=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenRouter (optional; enables openrouter/* model ids)
OPENROUTER_API_KEY=

# OpenCode Zen (optional; enables opencode/* model ids, e.g. opencode/deepseek-v4-flash)
OPENCODE_API_KEY=

# Per-task model overrides (defaults in code: Haiku for scope, Sonnet for sql/synthesize).
# Demo deployment: SQL + synthesis on gemini-3.7-flash (fast, stable, eval 22/22).
# Note: .env values override process-env vars (load_dotenv override=True), so
# change the model here, not via $env: when trialling.
MODEL_SCOPE=
MODEL_SQL=openrouter/google/gemini-3.7-flash
MODEL_SYNTH=openrouter/google/gemini-3.7-flash
# deepseek-v4.1-flash is the cheap alternative (~7x cheaper synth tokens) but
# showed unpredictable latency (up to 8 min) and occasional empty responses.

# Transport: true = Socket Mode (local demo), false = HTTP events (Cloud Run)
SOCKET_MODE=true

# Postgres (+ pgvector)
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent

# App
LOG_LEVEL=INFO
USAGE_LOG_PATH=logs/usage.jsonl

# LLM output token caps (per call). Raise if SQL or answers get cut off mid-stream.
# DeepSeek synthesis is verbose and bills reasoning tokens as output, so keep
# headroom (largest observed answer ~3k). OpenRouter pre-authorises max_tokens
# against the key's remaining credit, so a very high cap can 402 with a small
# key balance even when account credits exist; 12000 works on a near-empty key.
SCOPE_MAX_TOKENS=500
SQL_MAX_TOKENS=3000
SYNTH_MAX_TOKENS=12000
