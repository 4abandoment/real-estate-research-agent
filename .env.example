# Slack (Socket Mode)
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
SLACK_ADMIN_CHANNEL_ID=

# Slack app configuration token (for apps.manifest.*; expires after 12h)
SLACK_CONFIG_TOKEN=xoxe.xoxp-
SLACK_CONFIG_REFRESH_TOKEN=xoxe-
SLACK_APP_ID=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenRouter (optional; enables openrouter/* model ids)
OPENROUTER_API_KEY=

# Per-task model overrides (defaults in code: Haiku for scope, Sonnet for sql/synthesize).
# Demo deployment routes SQL + synthesis via OpenRouter (~20x cheaper; eval 54/54):
MODEL_SCOPE=
MODEL_SQL=openrouter/google/gemini-3.7-flash
MODEL_SYNTH=openrouter/deepseek/deepseek-v4.1-flash

# Transport: true = Socket Mode (local demo), false = HTTP events (Cloud Run)
SOCKET_MODE=true

# Postgres (+ pgvector)
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent

# App
LOG_LEVEL=INFO
USAGE_LOG_PATH=logs/usage.jsonl

# LLM output token caps (per call). Raise if SQL or answers get cut off mid-stream.
# DeepSeek synthesis is verbose + bills reasoning tokens as output; 30000 gives headroom.
SCOPE_MAX_TOKENS=500
SQL_MAX_TOKENS=3000
SYNTH_MAX_TOKENS=30000
